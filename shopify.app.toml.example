# Copy to an environment-specific Shopify CLI configuration only after creating
# the approved development app. No real app ID or secret is committed here.
client_id = "REPLACE_WITH_DEVELOPMENT_CLIENT_ID"
name = "EveryBatch Development"
application_url = "https://REPLACE_WITH_APPROVED_DEVELOPMENT_TUNNEL"
embedded = true

[build]
automatically_update_urls_on_dev = true

[access_scopes]
scopes = "read_orders,read_products"
use_legacy_install_flow = false

[auth]
redirect_urls = []

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = [
  "app/uninstalled",
  "orders/create",
  "orders/updated",
  "orders/cancelled",
  "refunds/create",
  "products/create",
  "products/update",
  "products/delete"
]
uri = "/api/integrations/shopify/webhooks"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/api/integrations/shopify/webhooks"
