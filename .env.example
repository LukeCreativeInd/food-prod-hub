NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost

# Shopify Connector v1 (server-only unless explicitly NEXT_PUBLIC_ prefixed)
SHOPIFY_APP_ENVIRONMENT=development
SHOPIFY_APP_HOST=http://localhost:3000
SHOPIFY_APP_CLIENT_ID=replace-with-development-app-client-id
SHOPIFY_APP_CLIENT_SECRET=replace-with-development-app-client-secret
SHOPIFY_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SHOPIFY_CREDENTIAL_KEY_VERSION=v1
SHOPIFY_WORKER_SECRET=replace-with-random-worker-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
